# Salin ke .env (JANGAN commit .env). Isi HANYA dengan wallet testnet.
# Private key di sini HANYA untuk deploy di testnet — jangan pernah pakai
# key yang memegang aset asli.

# RPC Aevum Testnet (default sudah benar, boleh dikosongkan)
AEVUM_RPC_URL=https://rpc-test.qday.info

# Alamat token tUSD8 RESMI di Aevum Testnet (isi setelah dikonfirmasi dari
# halaman Official Contract Addresses QDay / explorer, 16 Nov).
# Kosongkan = deploy memakai MockUSD8 (HANYA untuk dev/uji, bukan submission).
TOKEN_ADDRESS=

# Private key wallet deployer (testnet saja, tanpa 0x juga boleh).
# Dapatkan tQDAY dulu dari faucet: https://faucet.qday.info
DEPLOYER_PRIVATE_KEY=

# Alamat kontrak AevumPay setelah deploy (diisi otomatis oleh deploy script log;
# frontend membacanya dari sini saat build).
VITE_AEVUMPAY_ADDRESS=
VITE_TOKEN_ADDRESS=
